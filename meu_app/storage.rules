rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite que o usuário acesse apenas o próprio cofre na nuvem
    match /users/{userId}/vault/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Bloqueia todo o resto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
